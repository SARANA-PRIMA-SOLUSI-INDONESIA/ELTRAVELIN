generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Route {
  id                String             @id @default(cuid())
  origin            String
  destination       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDeleted         Boolean            @default(false)
  schedules         Schedule[]
  scheduleTemplates ScheduleTemplate[]
  stops             RouteStop[]

  @@unique([origin, destination])
}

model RouteStop {
  id        String   @id @default(cuid())
  routeId   String
  name      String
  sequence  Int
  stopTime  String?
  price     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookingsAsOrigin BookingSegment[] @relation("OriginStop")
  bookingsAsDestination BookingSegment[] @relation("DestinationStop")

  @@unique([routeId, sequence])
}

model Schedule {
  id              String            @id @default(cuid())
  routeId         String
  departureTime   DateTime
  arrivalTime     DateTime
  price           Int
  vehicleType     String
  capacity        Int               @default(11)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  templateId      String?
  isActive        Boolean           @default(true)
  isDeleted       Boolean           @default(false)
  operatingTripId String?
  bookings        Booking[]
  route           Route             @relation(fields: [routeId], references: [id])
  template        ScheduleTemplate? @relation(fields: [templateId], references: [id])
  operatingTrip   OperatingTrip?    @relation(fields: [operatingTripId], references: [id], onDelete: Cascade)
}

model ScheduleTemplate {
  id            String     @id @default(cuid())
  routeId       String
  departureTime String
  arrivalTime   String
  price         Int
  vehicleId     String
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  schedules     Schedule[]
  route         Route      @relation(fields: [routeId], references: [id])
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
}

model Booking {
  id              String        @id @default(cuid())
  bookingCode     String        @unique
  scheduleId      String
  passengerName   String?
  passengerEmail  String?
  passengerPhone  String?
  totalPrice      Int
  status          BookingStatus @default(PENDING)
  paymentMethod   String?
  paymentProofUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentType     String?
  settlementTime  DateTime?
  snapToken       String?
  contactEmail    String?
  contactName     String
  contactPhone    String
  discountAmount  Int           @default(0)
  promoCodeId     String?
  reminderSentAt  DateTime?
  lastReminderLevel Int           @default(0)
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id])
  schedule        Schedule      @relation(fields: [scheduleId], references: [id])
  passengers      Passenger[]
  seats           Seat[]
  segment         BookingSegment?
}

model BookingSegment {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  originStopId    String
  destinationStopId String
  basePrice       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  originStop      RouteStop @relation("OriginStop", fields: [originStopId], references: [id])
  destinationStop RouteStop @relation("DestinationStop", fields: [destinationStopId], references: [id])
}

model Passenger {
  id        String  @id @default(cuid())
  name      String
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Int
  minOrder      Int       @default(0)
  maxDiscount   Int?
  isActive      Boolean   @default(true)
  showOnCheckout Boolean  @default(false)
  startDate     DateTime?
  endDate       DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
}

model Seat {
  id              String        @id @default(cuid())
  operatingTripId String
  seatNumber      String
  status          SeatStatus    @default(AVAILABLE)
  bookingId       String?
  booking         Booking?      @relation(fields: [bookingId], references: [id])
  operatingTrip   OperatingTrip @relation(fields: [operatingTripId], references: [id], onDelete: Cascade)

  @@unique([operatingTripId, seatNumber])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  promoCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum TripStatus {
  SCHEDULED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Vehicle {
  id          String             @id @default(cuid())
  plateNumber String             @unique
  name        String
  capacity    Int
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  trips       OperatingTrip[]
  templates   ScheduleTemplate[]
}

model OperatingTrip {
  id          String       @id @default(cuid())
  vehicleId   String?
  date        DateTime     @db.Date
  status      TripStatus   @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  schedules   Schedule[]
  seats       Seat[]
}
