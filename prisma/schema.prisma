generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Route {
  id                String             @id @default(cuid())
  origin            String
  destination       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDeleted         Boolean            @default(false)
  schedules         Schedule[]
  scheduleTemplates ScheduleTemplate[]
  stops             RouteStop[]
}

model RouteStop {
  id        String   @id @default(cuid())
  routeId   String
  name      String
  sequence  Int?
  stopTime  String?
  price      Int      @default(0)
  isActive   Boolean  @default(true)
  canBoarding  Boolean  @default(true)
  canAlighting Boolean @default(true)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookingsAsOrigin BookingSegment[] @relation("OriginStop")
  bookingsAsDestination BookingSegment[] @relation("DestinationStop")

  @@unique([routeId, sequence, isDeleted])
}

model Schedule {
  id              String            @id @default(cuid())
  routeId         String
  departureTime   DateTime
  arrivalTime     DateTime
  price           Int
  vehicleType     String
  capacity        Int               @default(11)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  templateId      String?
  isActive        Boolean           @default(true)
  isDeleted       Boolean           @default(false)
  operatingTripId String?
  stopTimesJson   String?
  bookings        Booking[]
  route           Route             @relation(fields: [routeId], references: [id])
  template        ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  operatingTrip   OperatingTrip?    @relation(fields: [operatingTripId], references: [id], onDelete: Cascade)

  @@unique([templateId, departureTime, isDeleted])
}

model ScheduleTemplate {
  id            String     @id @default(cuid())
  routeId       String
  departureTime String
  arrivalTime   String
  price         Int
  capacity      Int        @default(15)
  vehicleId     String?
  dayOfWeek     Int?
  isActive      Boolean    @default(true)
  stopTimesJson String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  schedules     Schedule[]
  route         Route      @relation(fields: [routeId], references: [id])
  vehicle       Vehicle?   @relation(fields: [vehicleId], references: [id])
}

model Booking {
  id              String        @id @default(cuid())
  bookingCode     String        @unique
  scheduleId      String
  passengerName   String?
  passengerEmail  String?
  passengerPhone  String?
  totalPrice      Int
  status          BookingStatus @default(PENDING)
  paymentMethod   String?
  paymentProofUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentType     String?
  settlementTime  DateTime?
  snapToken       String?
  contactEmail    String?
  contactName     String
  contactPhone    String
  discountAmount  Int           @default(0)
  promoCodeId     String?
  reminderSentAt  DateTime?
  lastReminderLevel Int           @default(0)
  pickupRequested Boolean       @default(false)
  pickupCity      String?
  pickupZone      String?
  pickupAddress   String?
  pickupNote      String?
  pickupFee       Int           @default(0)
  pickupLat       Float?
  pickupLng       Float?
  pickupDistanceKm Float?
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  schedule        Schedule      @relation(fields: [scheduleId], references: [id])
  passengers      Passenger[]
  seats           Seat[]
  segment         BookingSegment?
}

model BookingSegment {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  originStopId    String
  destinationStopId String
  basePrice       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  originStop      RouteStop @relation("OriginStop", fields: [originStopId], references: [id])
  destinationStop RouteStop @relation("DestinationStop", fields: [destinationStopId], references: [id])
}

model Passenger {
  id        String  @id @default(cuid())
  name      String
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Int
  minOrder      Int       @default(0)
  maxDiscount   Int?
  isActive      Boolean   @default(true)
  showOnCheckout Boolean  @default(false)
  startDate     DateTime?
  endDate       DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
}

model Seat {
  id              String        @id @default(cuid())
  operatingTripId String
  seatNumber      String
  status          SeatStatus    @default(AVAILABLE)
  bookingId       String?
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  operatingTrip   OperatingTrip @relation(fields: [operatingTripId], references: [id], onDelete: Cascade)

  @@unique([operatingTripId, seatNumber])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  promoCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  CS
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum TripStatus {
  SCHEDULED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Vehicle {
  id           String             @id @default(cuid())
  plateNumber  String             @unique
  name         String
  driverName   String?
  capacity     Int
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  trips        OperatingTrip[]
  templates    ScheduleTemplate[]
  tourServices TourService[]
}

model OperatingTrip {
  id          String       @id @default(cuid())
  vehicleId   String?
  driverId    String?
  date        DateTime     @db.Date
  status      TripStatus   @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  schedules   Schedule[]
  seats       Seat[]
}

model Driver {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  licenseNo      String?
  isActive       Boolean         @default(true)
  restDayOfWeek  Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  operatingTrips OperatingTrip[]
}

// ─────────────────────────────────────────────────────────────
// Tour & Sewa (Paket Tour + Sewa Harian dengan alur nego/quote)
// ─────────────────────────────────────────────────────────────

enum TourServiceType {
  TOUR_PACKAGE
  DAILY_RENTAL
}

enum TourPriceUnit {
  PER_PAX
  PER_VEHICLE
  PER_DAY
}

enum TourInquiryStatus {
  NEW
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum TourQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model TourService {
  id             String          @id @default(cuid())
  type           TourServiceType
  name           String
  slug           String          @unique
  shortDesc      String?
  description    String?         @db.Text
  destinations   String?         @db.Text
  durationLabel  String?
  durationDays   Int?
  durationNights Int?
  itinerary      String?         @db.Text
  facilities     String?         @db.Text
  includes       String?         @db.Text
  excludes       String?         @db.Text
  basePrice      Int
  priceUnit      TourPriceUnit   @default(PER_PAX)
  minPax         Int             @default(1)
  maxPax         Int?
  vehicleId      String?
  imageUrl       String?
  gallery        String?         @db.Text
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  inquiries      TourInquiry[]
  bookings       TourBooking[]

  @@index([type, isActive])
  @@index([isFeatured])
}

model TourInquiry {
  id             String            @id @default(cuid())
  inquiryCode    String            @unique
  serviceId      String
  customerName   String
  customerEmail  String?
  customerPhone  String
  startDate      DateTime
  endDate        DateTime?
  paxCount       Int
  unitCount      Int               @default(1)
  pickupLocation String?
  notes          String?           @db.Text
  basePrice      Int
  status         TourInquiryStatus @default(NEW)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  service        TourService       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  quotes         TourQuote[]
  bookings       TourBooking[]

  @@index([status])
}

model TourQuote {
  id             String          @id @default(cuid())
  quoteNumber    String          @unique
  inquiryId      String
  pricePerUnit   Int
  unitCount      Int             @default(1)
  subtotal       Int
  discountType   String?
  discountValue  Int             @default(0)
  discountReason String?
  totalPrice     Int
  validUntil     DateTime?
  notes          String?         @db.Text
  status         TourQuoteStatus @default(DRAFT)
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inquiry        TourInquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  bookings       TourBooking[]
}

model TourBooking {
  id              String          @id @default(cuid())
  bookingCode     String          @unique
  inquiryId       String?
  quoteId         String?
  serviceId       String
  serviceName     String
  serviceType     TourServiceType
  startDate       DateTime
  endDate         DateTime?
  paxCount        Int
  unitCount       Int             @default(1)
  pickupLocation  String?
  customerName    String
  customerEmail   String?
  customerPhone   String
  basePrice       Int
  discountAmount  Int             @default(0)
  discountReason  String?
  totalPrice      Int
  status          BookingStatus   @default(PENDING)
  paymentMethod   String?
  paymentProofUrl String?
  paymentNote     String?
  verifiedBy      String?
  verifiedAt      DateTime?
  settlementTime  DateTime?
  notes           String?         @db.Text
  createdByAdmin  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  service         TourService     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inquiry         TourInquiry?    @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  quote           TourQuote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([paymentMethod])
}
